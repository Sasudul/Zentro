# ──────────────────────────────────────
# PULSE — Environment Variables
# ──────────────────────────────────────

# App
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3001

# Frontend (Next.js)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=    # used only in browser for map display

# Backend (Express.js)
PORT=3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:pass@host:5432/pulse

# Session
SESSION_SECRET=your-session-secret-min-32-chars-change-me
SESSION_MAX_AGE_MS=604800000          # 7 days in ms

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# External APIs
OPENWEATHERMAP_API_KEY=
GOOGLE_GEOCODING_API_KEY=             # backend geocoding (never exposed to browser)

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
