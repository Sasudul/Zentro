# Zentro environment variables

# App
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3001

# Frontend
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_ID=

# Backend
PORT=3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:pass@host:5432/zentro

# Session
SESSION_SECRET=your-session-secret-min-32-chars-change-me
SESSION_MAX_AGE_MS=2592000000

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth - GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# External APIs
OPENWEATHERMAP_API_KEY=
GOOGLE_GEOCODING_API_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis cache/session options
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=
